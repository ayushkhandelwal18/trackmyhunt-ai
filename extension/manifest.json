{
  "manifest_version": 3,
  "name": "TrackMyHunt",
  "version": "1.1.0",
  "description": "Save jobs to your TrackMyHunt dashboard directly from LinkedIn, Indeed, and more.",
  "action": {},
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://trackmyhunt.vercel.app/*"
      ],
      "js": ["src/content/dashboardAuth.js"]
    },
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.wellfound.com/*",
        "https://*.lever.co/*",
        "https://*.greenhouse.io/*",
        "https://*.ashbyhq.com/*",
        "https://*.naukri.com/*",
        "https://*.internshala.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workdayjobs.com/*",
        "https://docs.google.com/forms/*",
        "https://forms.google.com/*",
        "<all_urls>"
      ],
      "js": ["src/content/content.js"]
    }
  ]
}
